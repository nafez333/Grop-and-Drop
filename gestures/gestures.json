{
  "version": "1.0",
  "encoding": "prefix-free",
  "fuzzy_tolerance": 0,
  "bit_duration_default": 1.0,
  "gestures": {
    "wave": {
      "bits": [0, 0, 0, 1],
      "aliases": ["hello", "hi", "greet"],
      "description": "Hand wave",
      "category": "greeting",
      "priority": 1
    },
    "tap": {
      "bits": [0, 0, 1, 0],
      "aliases": ["click", "select"],
      "description": "Single tap",
      "category": "action",
      "priority": 1
    },
    "circle": {
      "bits": [0, 0, 1, 1],
      "aliases": ["loop", "rotate"],
      "description": "Circular motion",
      "category": "action",
      "priority": 2
    },
    "shake": {
      "bits": [0, 1, 0, 0],
      "aliases": ["no", "reject", "cancel"],
      "description": "Shake",
      "category": "negative",
      "priority": 1
    },
    "nod": {
      "bits": [0, 1, 0, 1],
      "aliases": ["yes", "confirm", "accept"],
      "description": "Nod",
      "category": "positive",
      "priority": 1
    },
    "swipe_left": {
      "bits": [0, 1, 1, 0],
      "aliases": ["previous", "back"],
      "description": "Swipe left",
      "category": "navigation",
      "priority": 2
    },
    "swipe_right": {
      "bits": [0, 1, 1, 1],
      "aliases": ["next", "forward"],
      "description": "Swipe right",
      "category": "navigation",
      "priority": 2
    },
    "fist": {
      "bits": [1, 0, 0, 0],
      "aliases": ["stop", "halt"],
      "description": "Closed fist",
      "category": "control",
      "priority": 1
    },
    "open_palm": {
      "bits": [1, 0, 0, 1],
      "aliases": ["pause", "wait"],
      "description": "Open palm",
      "category": "control",
      "priority": 2
    }
  },
  "reserved": {
    "1110": "future_use",
    "1111": "end_of_message"
  },
  "profiles": {
    "default": "gestures/gesture_profiles/default.json"
  }
}
